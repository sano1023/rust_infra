# Local development only. Copy to .env; never commit .env.
POSTGRES_DB=repia_development
POSTGRES_USER=repia
# Use a random alphanumeric/hex password (also used in DATABASE_URL).
POSTGRES_PASSWORD=replace_with_random_hex_password

# Normal use: 80. Use 8080 while another local environment occupies port 80.
HTTP_PORT=80
MAILPIT_UI_PORT=8025
# Used only with docker-compose.db-port.yml.
POSTGRES_PORT=5432

# Linux: set these to the output of id -u / id -g before building.
LOCAL_UID=1000
LOCAL_GID=1000
RUST_LOG=info
# The app must listen on 0.0.0.0:5150 inside its container.
APP_COMMAND='cargo run -- start --binding 0.0.0.0 --port 5150'
# Polling supports Docker Desktop / bind mounts as well as native Linux.
WATCH_POLL_INTERVAL=1s
